# --- LLM providers (set at least one; config.py picks based on MODEL_PROVIDER) ---
MODEL_PROVIDER=anthropic          # anthropic | openai
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# --- Indian Kanoon API ---
IK_API_TOKEN=your_indian_kanoon_api_token
IK_BASE_URL=https://api.indiankanoon.org

# --- RAG / vector store ---
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
VECTOR_STORE_PATH=./data/vector_store
WATCH_DIR=./data/incoming            # Pathway watches this dir for new files
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_MB=50
